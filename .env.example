NODE_ENV=production
NODE_PORT=4000
NODE_DATABASE_PATH=./storage/auth.db
NODE_CORS_ORIGINS=https://your-frontend.example.com
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
FRONTEND_URL=https://your-frontend.example.com
PYTHON_BACKEND_URL=http://localhost:8000
MONITOR_INTERVAL_MS=60000
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_CALLBACK_URL=https://your-auth.example.com/api/integrations/vercel/callback
VERCEL_SCOPES=openid profile email offline_access
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
